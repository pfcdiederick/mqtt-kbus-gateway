# WebSocket listener (MQTT Monitor page at /mqtt): anonymous clients may read everything and
# write only the bus settings and the outputs of kbus-gateway. The outputs are only written by the
# page in its control mode (settings menu); that switch protects against accidental clicks,
# it is not an access control (port 1883 has no login either). Not writable from the page:
# kbus/module/+/out/set and every topic outside kbus/.
topic read #
topic write kbus/bus/cycletime/set
topic write kbus/bus/rescan/set
topic write kbus/bus/resetstatistics/set
topic write kbus/do/+/set
topic write kbus/ao/+/set
